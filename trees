
def trees (h,x):
    down_count = []
    up_count = []
    h = 0
    count_increasing = 1
    count_decreasing = 1

    for i in range(1,len(x) -1):
            if x[i] > x[i +1]:
                count_increasing += 1
                up_count.append(count_increasing)
            elif x[i] < x[i + 1]:
                count_decreasing += 1
                down_count.append(count_decreasing)
    print(f'{h, max(down_count), count_decreasing}')

trees(4,[1,3,4,2])

